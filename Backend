FROM python:3.10.18

WORKDIR /app

# Install build & system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential gcc g++ gfortran \
    pkg-config cmake \
    libopenblas-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip + setuptools + wheel
RUN pip install --no-cache-dir --upgrade pip setuptools wheel

# Copy requirements first
COPY web_application/Backend/FlaskApp/requirements.txt .

# Install numpy first to avoid build issues
RUN pip install --no-cache-dir numpy

# Then install the rest of the requirements
RUN pip install --no-cache-dir --no-build-isolation -r requirements.txt


# Copy app code
COPY web_application/Backend/FlaskApp/ .

# Remove files you don’t want included
RUN rm -f calculate_coefficients.py stats.py QC.py

# Create required dirs
RUN mkdir -p /app/uploads /app/logs

# Permissions
RUN useradd -m -u 1000 flaskuser && chown -R flaskuser:flaskuser /app
USER flaskuser

# Healthcheck
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  CMD curl -f http://localhost:5000/health || exit 1

CMD ["python", "-m", "flask", "run", "--host=0.0.0.0", "--port=5000"]
